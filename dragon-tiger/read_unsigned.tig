let
  function skip_line() =
    let
      var c := getchar()
    in
      if c = "" then ()
      else if ord(c) = 10 then ()
      else skip_line()
    end

  function read_loop(acc : int, seen : int) : int =
    let
      var c := getchar()
    in
      if c = "" then
        if seen = 1 then acc else -1
      else if ord(c) = 10 then
        if seen = 1 then acc else -1
      else if ord(c) >= ord("0") & ord(c) <= ord("9") then
        read_loop(acc * 10 + ord(c) - ord("0"), 1)
      else
        (skip_line(); -1)
    end

  function read_unsigned() : int =
    read_loop(0, 0)

  var a : int := read_unsigned()
in
  print_int(a + 2);
  print("\n")
end